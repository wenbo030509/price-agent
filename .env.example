# 火山引擎 Ark API 配置
# 请在火山引擎控制台获取你的 API Key
# 访问：https://console.volcengine.com/ark/
ARK_API_KEY=your_api_key_here

# ── 多模型路由配置（可选） ──
# 不同阶段可使用不同模型以平衡成本与质量
# 不设置则所有阶段使用 ARK_MODEL 作为默认模型
ARK_MODEL=your_model_name                  # 默认/兜底模型（ReAct 循环）
ARK_MODEL_PLAN=your_model_name             # Phase 1 Plan 生成（推荐用擅长结构化输出的模型）
ARK_MODEL_SYNTHESIZE=your_model_name       # Phase 3 综合回答（推荐用推理能力强的模型）
ARK_MODEL_PARSE=your_model_name            # 属性解析（简单提取，轻量模型即可）
